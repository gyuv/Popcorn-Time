{
  "name": "popcorn-time",
  "productName": "Popcorn Time",
  "version": "1.0.0",
  "description": "Popcorn Time – discover movies, series and anime, find where to watch them legally, and track your library.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --universal --publish never",
    "cap:sync": "vite build && npx cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "app.popcorntime.desktop",
    "productName": "Popcorn Time",
    "files": ["dist/**", "electron/**"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"], "icon": "electron/icon.png" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.entertainment", "icon": "electron/icon.png" }
  }
}
